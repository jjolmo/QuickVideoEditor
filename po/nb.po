#. Translators: link title in the About dialog.
#: src/window.rs:922
msgid "Contribute Translations"
msgstr "Bidra med oversettelser"

#. Translators: name of https://gitlab.gnome.org/YaLTeR/identity
#: src/window.rs:928
msgid "Identity"
msgstr "Identitet"

#. Translators: summary of https://gitlab.gnome.org/YaLTeR/identity
#: src/window.rs:930
msgid "Compare images and videos"
msgstr "Sammenlign bilder og videoer"

#: src/window.rs:937
msgid ""
"This release improves the default output file naming and adds command-line "
"options."
msgstr "Denne versjonen forbedrer navngiving av forvalgt utfil og har flere kommandolinjealternativer."

#: src/window.rs:938
msgid "The default output filename now includes start and end timestamps."
msgstr "Forvalgt navn på utfil har nå tidsstempel for start og slutt."

#: src/window.rs:939
msgid ""
"Added command-line flags for start and end timestamps, precise trimming, and "
"removing audio."
msgstr "Lagt til kommandolinjeflagg for tidsstempel for start- og slutt, presis trimming og å fjerne lyd."

#: src/window.rs:940
msgid "Increased the default window size to make the video 960×540."
msgstr "Økt forvalgt vindustørrelse slik at video er 960x540."

#: src/window.rs:941
msgid "Updated to the GNOME 50 platform."
msgstr "Oppdatert til GNOME 50-plattformen."

#: src/window.rs:942
msgid "Updated translations."
msgstr "Oppdaterte oversettelser."

