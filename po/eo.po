#. Translators: Title that is shown if we couldn't load the video track for the opened file (but possibly loaded audio).
#: src/video_preview.blp:17
msgid "Could Not Load Video Track"
msgstr "Ne povis ŝargi videotrajton"

#. Translators: Description that is shown if we couldn't load the video track for the opened file (but possibly loaded audio).
#: src/video_preview.blp:20
msgid ""
"\"\"Maybe the file only has an audio track, or maybe the necessary video "
"codec \"\"is missing."
msgstr ""
"Eble la dosiero havas nur sontrakon, aŭ eble la necesa vida kodeko mankas."

#. Translators: file chooser file filter name.
#: src/window.rs:221
msgid "Video files"
msgstr "Videaj dosieroj"

#. Translators: file chooser dialog title.
#: src/window.rs:228
msgid "Open video"
msgstr "Malfermi videon"

#. Translators: error dialog title.
#: src/window.rs:239 src/window.rs:387 src/window.rs:630
msgid "Error"
msgstr "Eraro"

#. Translators: error dialog text.
#: src/window.rs:242 src/window.rs:390 src/window.rs:633
msgid ""
"\"\"Video Trimmer can only operate on local files. Please choose another "
"file."
msgstr ""
"Video Trimmer povas nur funkciadi pri lokaj dosieroj. Bonvolu elekti alian "
"dosieron."

#. Translators: error dialog button.
#: src/window.rs:247 src/window.rs:395 src/window.rs:572 src/window.rs:594
#: src/window.rs:638
msgid "_OK"
msgstr "_Bone"

#. Translators: this is appended to the output video file name.
#. So for example "my video.mp4" will become "my video (trimmed).mp4".
#: src/window.rs:356
msgid " (trimmed)"
msgstr " (tranĉita)"

#. Translators: message dialog text.
#: src/window.rs:482
msgid "Trimming…"
msgstr "Tranĉante…"

#. Translators: trimming dialog button.
#: src/window.rs:485
msgid "_Cancel"
msgstr "_Nuligi"

#. Translators: text on the toast after trimming was done.
#. The placeholder is the video filename.
#: src/window.rs:505
msgid "{} has been saved"
msgstr "{} estas konservita"

#. Translators: text on the button of the toast after
#. trimming was done to show the output file in the file
#. manager.
#: src/window.rs:512
msgid "Show in Files"
msgstr "Montri en dosieroj"

#. Translators: error dialog heading.
#: src/window.rs:544
msgid "Error trimming video"
msgstr "Eraro dum tranĉado de video"

#. Translators: error dialog text before the FFmpeg
#. error output.
#: src/window.rs:548
msgid "Please attach the following information when reporting an issue."
msgstr "Bonvolu aldoni la jenan informon kiam raportante problemon."

#: src/window.rs:559
msgid "Could not communicate with the ffmpeg subprocess"
msgstr "Ne povis komuniki kun la ffmpeg subprocezo"

#. Translators: error dialog text.
#: src/window.rs:590
msgid "Could not create the ffmpeg subprocess"
msgstr "Ne povis krei la ffmpeg subprocezon"

#. Translators: shown in the About dialog, put your name here.
#: src/window.rs:855
msgid "translator-credits"
msgstr "Kristjan SCHMIDT <kristjan.schmidt@googlemail.com>"

#. Translators: link title in the About dialog.
#: src/window.rs:858
msgid "Contribute Translations"
msgstr "Kontribui tradukojn"

#. Translators: name of https://gitlab.gnome.org/YaLTeR/identity
#: src/window.rs:864
msgid "Identity"
msgstr "Identity"

#. Translators: summary of https://gitlab.gnome.org/YaLTeR/identity
#: src/window.rs:866
msgid "Compare images and videos"
msgstr "Kompari bildojn kaj videojn"

#: src/window.rs:873
msgid "This release makes the trimming options more discoverable."
msgstr "Ĉi tiu eldono faras la tranĉad-opciojn pli malkovreblajn."

#: src/window.rs:874
msgid "Changed the versioning scheme to year.month."
msgstr "Ŝanĝis la versiad-skimon al jaro.monato."

#: src/window.rs:875
msgid ""
"\"\"Moved the accurate trimming and remove audio options from the save "
"dialog to \"\"the main window."
msgstr ""
"Movis la precizajn tranĉad- kaj forigaŭdio-opciojn el la konserva dialogo al "
"la ĉefa fenestro."

#: src/window.rs:876
msgid "Added , and . shortcuts for short video stepping."
msgstr "Aldonitaj , kaj . mallongigoj por mallonga videopaŝado."

#: src/window.rs:877
msgid "Updated to the GNOME 48 platform."
msgstr "Ĝisdatigita al la GNOME 48 platformo."

#: src/window.rs:878
msgid "Updated translations."
msgstr "Ĝisdatigitaj tradukoj."

#. Translators: Primary menu entry that opens a new window.
#: src/window.blp:8
msgid "_New Window"
msgstr "_Nova fenestro"

#. Translators: Primary menu entry that opens the Keyboard Shortcuts dialog.
#: src/window.blp:14
msgid "_Keyboard Shortcuts"
msgstr "_Klav-mallongigoj"

#. Translators: Primary menu entry that opens the About dialog.
#: src/window.blp:20
msgid "_About Video Trimmer"
msgstr "_Pri Video Trimmer"

#. Translators: Options menu entry title that enables accurate trimming with re-encoding.
#: src/window.blp:32
msgid "Precise Trim"
msgstr "Preciza tranĉo"

#. Translators: Options menu entry subtitle that enables accurate trimming with re-encoding.
#: src/window.blp:34
msgid "Slower and may lose quality due to re-encoding"
msgstr "Pli malrapida kaj eble perdas kvaliton pro re-kodumado"

#. Translators: Options menu entry that strips audio from the video file.
#: src/window.blp:39
msgid "Remove Audio"
msgstr "Forigi sonaron"

#. Translators: Main menu button tooltip.
#: src/window.blp:68 src/window.blp:124
msgid "Main Menu"
msgstr "Ĉefa menuo"

#. Translators: Title text on the window when no files are open.
#: src/window.blp:77
msgid "Trim Videos"
msgstr "Tranĉi videojn"

#. Translators: Description text on the window when no files are open.
#: src/window.blp:80
msgid "Drag and drop a video here"
msgstr "Trenu kaj faligu videon ĉi tien"

#. Translators: Open button label when no files are open.
#: src/window.blp:84
msgid "Open Video…"
msgstr "Malfermi videon…"

#. Translators: Open button tooltip.
#: src/window.blp:86
msgid "Select a Video"
msgstr "Elekti videon"

#. Translators: Trim button.
#: src/window.blp:110
msgid "Trim"
msgstr "Tranĉi"

#. Translators: Trim button tooltip.
#: src/window.blp:113
msgid "Trim Video"
msgstr "Tranĉi videon"

#. Translators: Title that is shown upon video preview loading error.
#: src/window.blp:152
msgid "Video Preview Failed to Load"
msgstr "Video-antaŭvido malsukcesis ŝargiĝi"

#. Translators: Description that is shown upon video preview loading error.
#: src/window.blp:155
msgid ""
"\"\"Please enter the start and end timestamps manually.\n"
"\"\"\n"
"\"\"If you're running Video Trimmer under Flatpak, note that opening files "
"by \"\"drag-and-drop may not work."
msgstr ""
"Bonvolu mane enigi la komencan kaj finan tempindikojn.\n"
"\n"
"Se vi prizorgas Video Trimmer sub Flatpak, notu ke malfermi dosierojn per "
"trenu-kaj-faligu eble ne funkcios."

#. Translators: Label for the entry for the start timestamp.
#: src/window.blp:175
msgid "Start"
msgstr "Komenco"

#. Translators: Label for the entry for the end timestamp.
#: src/window.blp:192
msgid "End"
msgstr "Fino"

#: data/org.gnome.gitlab.YaLTeR.VideoTrimmer.desktop.in.in:3
#: data/org.gnome.gitlab.YaLTeR.VideoTrimmer.metainfo.xml.in.in:6
msgid "Trim videos quickly"
msgstr "Tranĉi videojn rapide"

#. Translators: search terms to find this application. Do NOT translate or localize the semicolons! The list MUST also end with a semicolon!
#: data/org.gnome.gitlab.YaLTeR.VideoTrimmer.desktop.in.in:5
msgid "Cut;Movie;Film;Clip;"
msgstr "Cut;Movie;Film;Clip;"

#. developer_name tag deprecated with Appstream 1.0
#: data/org.gnome.gitlab.YaLTeR.VideoTrimmer.metainfo.xml.in.in:13
msgid "Ivan Molodetskikh"
msgstr "Ivan Molodetskikh"

#: data/org.gnome.gitlab.YaLTeR.VideoTrimmer.metainfo.xml.in.in:23
msgid ""
"\"\"Video Trimmer cuts out a fragment of a video given the start and end "
"\"\"timestamps. The video is never re-encoded, so the process is very fast "
"and \"\"does not reduce the video quality."
msgstr ""
"Video Trimmer eltondas fragmenton de video donante la komencan kaj finan "
"tempindikojn. La video neniam re-kodumiĝas, do la procezo estas tre rapida "
"kaj ne malpliigas la vidan kvaliton."

#: data/org.gnome.gitlab.YaLTeR.VideoTrimmer.metainfo.xml.in.in:30
msgid "Main Window"
msgstr "Ĉefa fenestro"
