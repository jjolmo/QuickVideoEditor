msgstr "Myndskeiðasskrár"

#. Translators: file chooser dialog title.
#: src/window.rs:260
msgid "Open video"
msgstr "Opna myndskeið"

#. Translators: error dialog title.
#: src/window.rs:271 src/window.rs:434 src/window.rs:677
msgid "Error"
msgstr "Villa"

#. Translators: error dialog text.
#: src/window.rs:274 src/window.rs:437 src/window.rs:680
msgid ""
"Video Trimmer can only operate on local files. Please choose another file."
msgstr "Video Trimmer getur bara unnið með staðværar skrár. Veldu aðra skrá."

