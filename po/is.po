msgstr "Villa við að klippa myndskeið"

#. Translators: error dialog text before the FFmpeg
#. error output.
#: src/window.rs:595
msgid "Please attach the following information when reporting an issue."
msgstr "Vinsamlegast hafðu eftirfarandi upplýsingar með í villuskýrslu."

#: src/window.rs:606
msgid "Could not communicate with the ffmpeg subprocess"
msgstr "Gat ekki átt samskipti við ffmpeg undirferli"

#. Translators: error dialog text.
#: src/window.rs:637
