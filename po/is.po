msgstr "Almennt"

#: src/shortcuts.blp:12
msgctxt "shortcut window"
msgid "New window"
msgstr "Nýr gluggi"

#: src/shortcuts.blp:17
msgctxt "shortcut window"
msgid "Play / Pause"
msgstr "Spila / Stöðva"

