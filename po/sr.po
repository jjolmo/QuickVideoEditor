msgstr "Пушта / Застаје"

#: src/shortcuts.blp:22
msgctxt "shortcut window"
msgid "Trim"
msgstr "Одсеца"

#: src/shortcuts.blp:27
msgctxt "shortcut window"
msgid "Set Start at current postion"
