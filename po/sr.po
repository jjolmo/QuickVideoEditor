#: src/shortcuts.blp:9
msgctxt "shortcut window"
msgid "General"
msgstr "Опште"

#: src/shortcuts.blp:12
msgctxt "shortcut window"
msgid "New window"
msgstr "Нови прозор"

#: src/shortcuts.blp:17
msgctxt "shortcut window"
