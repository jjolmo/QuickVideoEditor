#. Translators: error dialog heading.
#: src/window.rs:591
msgid "Error trimming video"
msgstr "Napaka pri obrezavi videa"

#. Translators: error dialog text before the FFmpeg
#. error output.
#: src/window.rs:595
msgid "Please attach the following information when reporting an issue."
msgstr "Pri prijavi težave priložite naslednje informacije."

#: src/window.rs:606
msgid "Could not communicate with the ffmpeg subprocess"
msgstr "Ni možno komunicirati s podprocesom ffmpeg"

#. Translators: error dialog text.
#: src/window.rs:637
msgid "Could not create the ffmpeg subprocess"
msgstr "Ni možno ustvariti podprocesa ffmpeg"

#. Translators: shown in the About dialog, put your name here.
#: src/window.rs:902
msgid "translator-credits"
msgstr "Martin Srebotnjak <miles@filmsi.net>"

#. Translators: link title in the About dialog.
#: src/window.rs:905
msgid "Contribute Translations"
msgstr "Prispevajte prevode"

#. Translators: name of https://gitlab.gnome.org/YaLTeR/identity
#: src/window.rs:911
msgid "Identity"
msgstr "Identiteta"

#. Translators: summary of https://gitlab.gnome.org/YaLTeR/identity
#: src/window.rs:913
msgid "Compare images and videos"
msgstr "Primerjava slik in videoposnetkov"

#: src/window.rs:920
msgid ""
"This release improves the default output file naming and adds command-line "
"options."
msgstr ""
"Ta izdaja izboljšuje privzeto poimenovanje izhodne datoteke in dodaja "
"možnosti v ukazni vrstici."

#: src/window.rs:921
msgid "The default output filename now includes start and end timestamps."
msgstr ""
"Privzeto ime izhodne datoteke zdaj vključuje začetni in zaključni časovni "
"žig."

#: src/window.rs:922
msgid ""
"Added command-line flags for start and end timestamps, precise trimming, and "
"removing audio."
msgstr ""
"Dodane zastavice ukazne vrstice za začetni in končni časovni žig, natančno "
"obrezovanje in odstranjevanje zvoka."

#: src/window.rs:923
msgid "Increased the default window size to make the video 960×540."
msgstr "Povečana privzeta velikost okna za izdelavo videoposnetkov 960x540."

#: src/window.rs:924
msgid "Updated to the GNOME 50 platform."
msgstr "Posodobljeno na platformo GNOME 50."

#: src/window.rs:925
msgid "Updated translations."
msgstr "Posodobljeni prevodi."

