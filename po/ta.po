msgstr "வீடியோ கோப்பைத் திறக்க ஓபன் பட்டனை அழுத்தவும்."

#. Label for the entry for the end timestamp.
#: src/window.blp:164
msgid "End"
msgstr "முடிவு"

#. Label for the entry for the start timestamp.
#: src/window.blp:147
msgid "Start"
msgstr "தொடங்கு"

#. Video open button label.
#: src/window.blp:45
msgid "Open"
msgstr "திறக்கவும்"

#. Trim button.
#: src/window.blp:71
