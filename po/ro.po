msgstr "Nu s-a putut crea subprocesul ffmpeg"

#. Translators: file chooser file filter name.
#: src/window.rs:914
msgid "Video files"
msgstr "Fișiere video"

#. Translators: file chooser dialog title.
#: src/window.rs:923
msgid "Open video"
msgstr "Deschide videoclipul"

#. Label on the initial state.
