#. So for example "my video.mp4" will become "my video (trimmed).mp4".
#: src/window.rs:356
msgid " (trimmed)"
msgstr " (trimmet)"

#. Translators: message dialog text.
#: src/window.rs:482
msgid "Trimming…"
msgstr "Trimmer …"

#. Translators: trimming dialog button.
#: src/window.rs:485
msgid "_Cancel"
msgstr "_Annullér"

