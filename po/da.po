#: src/window.rs:937
msgid ""
"This release improves the default output file naming and adds command-line "
"options."
msgstr ""
"Denne udgivelse forbedrer standardnavngivningen af outputfiler og tilføjer "
"kommandolinjetilvalg."

#: src/window.rs:938
msgid "The default output filename now includes start and end timestamps."
msgstr ""
"Standardfilnavnet for output indeholder nu tidsstempler for start og slut."

#: src/window.rs:939
msgid ""
"Added command-line flags for start and end timestamps, precise trimming, and "
"removing audio."
msgstr ""
"Der er tilføjet kommandolinjeflag til start- og sluttidsstempler, præcis "
"trimning og fjernelse af lyd."

#: src/window.rs:940
msgid "Increased the default window size to make the video 960×540."
msgstr "Standardstørrelsen på vinduet er forøget, så videoen er 960×540."

#: src/window.rs:941
msgid "Updated to the GNOME 50 platform."
msgstr "Opdateret til GNOME 50-platformen."

#: src/window.rs:942
msgid "Updated translations."
msgstr "Opdaterede oversættelser."

