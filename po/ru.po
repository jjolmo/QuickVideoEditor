msgid "Could not get input video information"
msgstr "Не удалось получить информацию о входном видео"

#. Translators: this is the name part of the default filename presented in the save dialog.
#: src/window.rs:544
msgid "Trimmed video"
msgstr "Обрезанное видео"

#. Translators: message dialog text.
#: src/window.rs:580
msgid "Trimming…"
msgstr "Обрезка…"

#. Translators: message dialog text.
#: src/window.rs:597
msgid "Done!"
msgstr "Готово!"

#. Translators: error dialog text.
#: src/window.rs:602
