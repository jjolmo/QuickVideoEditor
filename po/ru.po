msgstr "Открыть"

#. Trim button.
#: src/window.ui:36
msgid "Trim"
msgstr "Обрезать"

#. Label on the initial state.
#: src/window.ui:88
msgid "Press the Open button to open a video file."
msgstr "Нажмите на кнопку Открыть, чтобы выбрать видео."

#. Label for the entry for the end timestamp.
#: src/window.ui:136
