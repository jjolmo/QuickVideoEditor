msgstr "В этой версии визуальный стиль немного обновлён для GNOME 45."

#: src/window.rs:768
msgid "Tweaked the visual style for the GNOME 45 release."
msgstr "Визуальный стиль обновлён для GNOME 45."

#: src/window.rs:769
msgid "Fixed app crashing when ffprobe is missing."
msgstr "Исправлено аварийное завершение при отсутствующем ffprobe."

#: src/window.rs:770
msgid "Updated to the GNOME 45 platform."
msgstr "Платформа обновлена до версии GNOME 45."

#: src/window.rs:771
msgid "Updated translations."
msgstr "Обновлены переводы."

