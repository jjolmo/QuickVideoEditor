msgstr "Bertsio honek GNOME 45 plataformarako aldaketa txiki batzuk egin dira."

#: src/window.rs:788
msgid "Tweaked the visual style for the GNOME 45 release."
msgstr "Ikusizko estiloa doitu da GNOME 45 bertsiorako egokitzeko."

#: src/window.rs:789
msgid "Fixed app crashing when ffprobe is missing."
msgstr "ffprobe falta denean gertatzen zen kraskadura konpondu da."

#: src/window.rs:790
msgid "Updated to the GNOME 45 platform."
msgstr "GNOME 45 plataformarako eguneratu da."

#: src/window.rs:791
msgid "Updated translations."
msgstr "Itzulpenak eguneratu dira."

