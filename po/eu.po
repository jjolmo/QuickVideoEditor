msgstr "Ezin izan da lortu sarrerako bideo-informazioa"

#. Label on the initial state.
#: src/window.blp:85
msgid "Press the Open button to open a video file."
msgstr "Sakatu Ireki botoia bideo-fitxategi bat irekitzeko."

#. Label for the entry for the end timestamp.
#: src/window.blp:155
msgid "End"
msgstr "Amaitu"

#. Label for the entry for the start timestamp.
#: src/window.blp:138
msgid "Start"
msgstr "Hasi"

#. Video open button label.
