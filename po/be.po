#: src/shortcuts.blp:9
msgctxt "shortcut window"
msgid "General"
msgstr "Агульныя"

#: src/shortcuts.blp:12
msgctxt "shortcut window"
msgid "New window"
msgstr "Новае акно"

#: src/shortcuts.blp:17
msgctxt "shortcut window"
