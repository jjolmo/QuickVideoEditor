using Gtk 4.0;
using Adw 1;

Adw.ShortcutsDialog shortcuts_dialog {
  Adw.ShortcutsSection {
    title: C_("shortcut window", "General");

    Adw.ShortcutsItem {
      title: C_("shortcut window", "Trim");
      action-name: "win.trim";
    }

    Adw.ShortcutsItem {
      title: C_("shortcut window", "Set Start at current postion");
      action-name: "win.set-start-as-position";
    }

    Adw.ShortcutsItem {
      title: C_("shortcut window", "Set End at current position");
      action-name: "win.set-end-as-position";
    }
  }

  Adw.ShortcutsSection {
    Adw.ShortcutsItem {
      title: C_("shortcut window", "New window");
      action-name: "app.new-window";
    }

    Adw.ShortcutsItem {
      title: C_("shortcut window", "Close window");
      action-name: "win.close";
    }

    Adw.ShortcutsItem {
      title: C_("shortcut window", "Keyboard shortcuts");
      action-name: "app.shortcuts";
    }

    Adw.ShortcutsItem {
      title: C_("shortcut window", "Quit");
      action-name: "app.quit";
    }
  }

  Adw.ShortcutsSection {
    title: C_("shortcut window", "Playback");

    Adw.ShortcutsItem {
      title: C_("shortcut window", "Play / Pause");
      action-name: "win.play-pause";
    }

    Adw.ShortcutsItem {
      title: C_("shortcut window", "Step forward");
      accelerator: "period";
    }

    Adw.ShortcutsItem {
      title: C_("shortcut window", "Step back");
      accelerator: "comma";
    }
  }
}
