<?xml version="1.0" encoding="UTF-8"?>
<!-- Copyright 2020 Ivan Molodetskikh; fork by jjolmo -->
<component type="desktop-application">
	<id>@app_id@</id>
	<name>Quick Video Editor</name>
	<summary>Edit videos quickly</summary>
	<metadata_license>CC0-1.0</metadata_license>
	<project_license>GPL-3.0-or-later</project_license>
	<launchable type="desktop-id">@app_id@.desktop</launchable>
	<translation type="gettext">quick-video-editor</translation>
	<content_rating type="oars-1.0" />
	<!-- developer_name tag deprecated with Appstream 1.0 -->
	<developer_name>jjolmo</developer_name>
	<developer id="io.github.jjolmo">
		<name>jjolmo</name>
	</developer>
	<update_contact>olmogil@gmail.com</update_contact>
	<url type="homepage">https://github.com/jjolmo/QuickVideoEditor</url>
	<url type="bugtracker">https://github.com/jjolmo/QuickVideoEditor/issues</url>
	<url type="translate">https://l10n.gnome.org/module/video-trimmer/</url>
	<url type="vcs-browser">https://github.com/jjolmo/QuickVideoEditor</url>
	<description>
		<p>
			Quick Video Editor cuts out a fragment of a video given the start and end timestamps. The video is never re-encoded, so the process is very fast and does not reduce the video quality.
		</p>
		<p>
			Quick Video Editor is a fork of Video Trimmer by Ivan Molodetskikh.
		</p>
	</description>
	<screenshots>
		<screenshot type="default">
			<image>https://raw.githubusercontent.com/jjolmo/QuickVideoEditor/main/data/screenshots/trimmer.png</image>
			<caption>Trimmer</caption>
		</screenshot>
		<screenshot>
			<image>https://raw.githubusercontent.com/jjolmo/QuickVideoEditor/main/data/screenshots/editor.png</image>
			<caption>Editor with music</caption>
		</screenshot>
	</screenshots>
	<branding>
		<color type="primary" scheme_preference="light">#aecef4</color>
		<color type="primary" scheme_preference="dark">#1c3f68</color>
	</branding>
	<releases>
		<release version="0.1.0" date="2026-09-27">
			<description>
				<p>First release of Quick Video Editor, a fork of Video Trimmer 26.03.1.</p>
				<ul>
					<li>Editor mode: cut, move, trim and speed up segments of one or more videos, with crossfades where they overlap, undo and redo.</li>
					<li>Music tracks with a movable waveform, volume and fade-out, and a volume knob for the videos' own audio.</li>
					<li>Speed control from 10% to 1000% that keeps the pitch.</li>
					<li>Export frame rate and resolution options, and snapping to 0:59 for social networks.</li>
					<li>Preview built on GStreamer Editing Services, so the preview matches the export.</li>
				</ul>
			</description>
		</release>
	</releases>
	<recommends>
		<control>pointing</control>
		<control>keyboard</control>
		<control>touch</control>
	</recommends>
	<requires>
		<display_length compare="ge">360</display_length>
	</requires>
</component>
